# This is the environment configuration for the Railway production environment.
# Ensure that the environment variables are set correctly in Railway.
APP_ENV=production
MYSQL_HOST=${MYSQLHOST}
MYSQL_USER=${MYSQLUSER}
MYSQL_PASSWORD=${MYSQLPASSWORD}
MYSQL_DATABASE=${MYSQLDATABASE}
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
